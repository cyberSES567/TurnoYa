rules_version = '2';
// Pega esto en Firebase Console → Firestore → Reglas.
// Si cambias el correo del dueño en config.js, cámbialo también aquí (2 lugares).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && me() == 'adminegocio1923@gmail.com'; }
    function staffRef() { return /databases/$(database)/documents/staff/$(me()); }
    function hasStaff() { return signedIn() && exists(staffRef()) && get(staffRef()).data.active == true; }
    function isAdmin() { return isOwner() || (hasStaff() && get(staffRef()).data.role == 'admin'); }
    function isStaff() { return isOwner() || hasStaff(); }
    function isBanned() { return signedIn() && exists(/databases/$(database)/documents/banned/$(me())); }

    // Menú: todos los usuarios con sesión lo leen; solo admins lo editan.
    match /menu/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Equipo: cada quien lee su propio documento (así sabe su rol); el equipo ve la lista.
    // Nadie puede crear/editar/borrar al dueño (el dueño vive en config, no en esta lista).
    match /staff/{email} {
      allow read: if signedIn() && (email == me() || isStaff());
      allow write: if isAdmin() && email != 'adminegocio1923@gmail.com';
    }

    // Baneados
    match /banned/{email} {
      allow read: if signedIn() && (email == me() || isAdmin());
      allow write: if isAdmin() && email != 'adminegocio1923@gmail.com';
    }

    // Perfil mínimo (sirve para sincronizar el reloj y mapear uid → correo para el admin)
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow write: if signedIn() && uid == request.auth.uid && request.resource.data.email == me();
    }

    // Pedidos
    match /orders/{id} {
      allow read: if signedIn() && (isStaff() || resource.data.customerUid == request.auth.uid);

      allow create: if isAdmin() || (
        signedIn() && !isBanned()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'espera'
        && request.resource.data.createdAt == request.time
      );

      allow update: if isStaff() || (
        signedIn() && resource.data.customerUid == request.auth.uid && (
          // reseña una sola vez, cuando el pedido ya está listo o entregado
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])
            && resource.data.status in ['listo', 'entregado']
            && !('review' in resource.data))
          ||
          // cancelar mientras sigue en espera
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'espera'
            && request.resource.data.status == 'cancelado')
        )
      );

      allow delete: if isAdmin();
    }
  }
}
