rules_version = '2';
// Pega esto en Firebase Console → Firestore → Reglas.
// El correo del dueño debe ser IGUAL en config.js y aquí (3 lugares abajo).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.token.get('email', '').lower(); }
    // Evita que alguien se registre con el correo de un empleado/dueño sin ser dueño de ese correo.
    function verified() { return request.auth.token.get('email_verified', false) == true; }

    // 2FA por código a Gmail: cuando despliegues las Cloud Functions, cambia `true` por:
    //   request.auth.token.get('o2', 0) > request.time.toMillis()
    function ownerCode() { return true; }

    // El dueño SOLO entra con Google, con correo verificado (y con código si activas 2FA).
    function isOwner() {
      return signedIn() && verified()
        && me() == 'adminnegocio1923@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && ownerCode();
    }

    function staffRef() { return /databases/$(database)/documents/staff/$(me()); }
    function hasStaff() {
      return signedIn() && verified() && me() != ''
        && exists(staffRef()) && get(staffRef()).data.active == true;
    }
    function role() { return get(staffRef()).data.role; }

    function isAdmin()  { return isOwner() || (hasStaff() && role() == 'admin'); }
    function isMod()    { return isAdmin() || (hasStaff() && role() == 'moderador'); }
    function isWaiter() { return hasStaff() && (role() == 'mesero' || role() == 'receptor'); }
    function isCook()   { return hasStaff() && role() == 'cocinero'; }
    function canOrders(){ return isAdmin() || isWaiter() || isCook(); }
    function isStaff()  { return isOwner() || hasStaff(); }

    function isBanned() {
      return signedIn() && me() != ''
        && exists(/databases/$(database)/documents/banned/$(me()));
    }
    function myDiscount() {
      return exists(/databases/$(database)/documents/loyalty/$(request.auth.uid))
        ? get(/databases/$(database)/documents/loyalty/$(request.auth.uid)).data.discount
        : 0;
    }

    // Menú
    match /menu/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Equipo (roles: admin, moderador, mesero, cocinero). Nadie edita al dueño.
    match /staff/{email} {
      allow read: if signedIn() && (email == me() || isStaff());
      allow write: if isAdmin() && email != 'adminnegocio1923@gmail.com';
    }

    // Baneados (los moderadores también pueden banear)
    match /banned/{email} {
      allow read: if signedIn() && (email == me() || isMod());
      allow write: if isMod() && email != 'adminnegocio1923@gmail.com';
    }

    // Perfil mínimo (reloj del servidor y uid → correo)
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isMod());
      allow write: if signedIn() && uid == request.auth.uid && request.resource.data.email == me();
    }

    // Pedidos
    match /orders/{id} {
      allow read: if signedIn() && (isStaff() || resource.data.customerUid == request.auth.uid);

      allow create: if isAdmin() || (
        signedIn() && !isBanned()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'espera'
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('discount', 0) == myDiscount()
      );

      allow update: if canOrders() || (
        signedIn() && resource.data.customerUid == request.auth.uid && (
          // reseña una sola vez, cuando el pedido ya está listo o entregado
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])
            && resource.data.status in ['listo', 'entregado']
            && !('review' in resource.data))
          ||
          // cancelar mientras sigue en espera
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status == 'espera'
            && request.resource.data.status == 'cancelado')
        )
      );

      allow delete: if isAdmin();
    }

    // Ofertas: las ven todos, las gestionan admin y moderadores
    match /offers/{id} {
      allow read: if signedIn();
      allow write: if isMod();
    }

    // Reseñas públicas (id = id del pedido). Una por pedido, solo del dueño del pedido.
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (
        signedIn() && !isBanned()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/orders/$(id)).data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(id)).data.status in ['listo', 'entregado']
      );
      allow update: if false;
      allow delete: if isMod();
    }

    // Descuentos de fidelidad (id = uid del cliente). Los asignan los moderadores.
    match /loyalty/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isMod());
      allow write: if isMod()
        && request.resource.data.discount is int
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= 50
        && request.resource.data.discount % 5 == 0;
    }

    // Chat cliente ↔ moderadores (id = uid del cliente)
    match /chats/{uid} {
      allow read, write: if signedIn() && (uid == request.auth.uid || isMod());

      match /messages/{mid} {
        allow read: if signedIn() && (uid == request.auth.uid || isMod());
        allow create: if signedIn() && !isBanned()
          && (uid == request.auth.uid || isMod())
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Chat interno del equipo
    match /teamchat/{mid} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
